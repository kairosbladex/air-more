# Copy into an untracked environment file. Never send this token to a browser.
# Generate a token: python -c 'import secrets; print(secrets.token_urlsafe(32))'
AIRMORE_CLIENTS_JSON='{"business-backend":"REPLACE_WITH_A_RANDOM_32_BYTE_TOKEN"}'
AIRMORE_STATE_DIR=var-airmore
AIRMORE_DB_HOST=127.0.0.1
AIRMORE_DB_PORT=3306
AIRMORE_DB_NAME=business_database
AIRMORE_DB_USER=report_reader
AIRMORE_DB_PASSWORD=
AIRMORE_QUERY_TIMEOUT_MS=10000
AIRMORE_MAX_ROWS=500000
AIRMORE_MAX_DAYS=366
AIRMORE_MAX_HANGARS=50
AIRMORE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AIRMORE_OLLAMA_MODEL=qwen3.5:9b
AIRMORE_MODEL_TIMEOUT=120
AIRMORE_COMPANY=北京卓翼航空装备集团有限公司
AIRMORE_SOFFICE=soffice
# JSON path, operator-reviewed per-device units and sampling attestations.
# Empty means no fixed-point eligibility; survey data can still be shown.
AIRMORE_MEASUREMENT_PROFILES=
# Optional: server-owned JSON mapping project ID to indicators API base_url/headers.
# Actual credentials stay in this private file, never in report requests/evidence.
# AIRMORE_INDICATORS_PROJECTS=/private/path/indicators-projects.json
